# .env.example - Variables de Entorno del Sistema de Información Poblacional

# Configuración Django
SECRET_KEY=tu-secret-key-super-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de Datos - PostgreSQL (Producción)
DB_NAME=sip_database
DB_USER=sip_user
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=5432

# Base de Datos - SQLite (Desarrollo - más fácil)
USE_SQLITE=True

# Email (para recuperación de contraseñas)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password

# Archivos Media
MEDIA_URL=/media/
MEDIA_ROOT=media/

# Archivos Estáticos
STATIC_URL=/static/
STATIC_ROOT=staticfiles/

# Configuración de la aplicación
SITE_NAME=Sistema de Información Poblacional
DEFAULT_FROM_EMAIL=noreply@sip-proyecto.com

# Configuración de desarrollo
DJANGO_LOG_LEVEL=DEBUG